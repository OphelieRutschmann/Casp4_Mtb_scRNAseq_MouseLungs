#### Load dataset and initialization ####
so<-readRDS("/Users/orutschm/Documents/Lab_work/Bystanders/scRNAseq/Russel/GSE167232_mtb_integrated.rds")
so <- initialization(so)
source("/Users/orutschm/Documents/Lab_work/Bystanders/scRNAseq/Russel/initialization.R")
so <- initialization(so)
#Vectors with names in case we need them
alveolar <- c("AM_4", "AM_1", "AM_2", "AM_3")
interstitial <- c("IM_1", "IM_2", "IM_3", "IM_4")
macrophages <- c("AM_4", "AM_1", "AM_2", "AM_3", "IM_1", "IM_2", "IM_3", "IM_4")
# create a logical vector with TRUE for all infected cells
is_infected <- as.logical(so$Status == "infected")
#create a logical vector with TRUE for all cells expressing Casp4
is_Casp4pos <- as.logical(so$Casp4_value == "expressing")
#Create an object with only the interstitial macrophages and set the identity of the cells to their infection status
Interstitial_so <- subset(so, idents = interstitial)
Idents(Interstitial_so) <- "Status"
#Create an object with only the alveolar macrophages and set the identity of the cells to their infection status
Alveolar_so <- subset(so, idents = alveolar)
Idents(Alveolar_so) <- "Status"
#take only the infected cells
Idents(Interstitial_so) <- "Status"
infected_so <- subset(Interstitial_so, idents = "infected")
Idents(infected_so) <- "Casp4_status"
#Find differentially expressed genes between casp4-expressing and non-expressing cells that are infected with Mtb
Casp4.de.markers <- FindMarkers(infected_so, ident.1 = "expressing", ident.2 = "not_expressing")
Casp4.de.markers.pos <- subset(Casp4.de.markers, Casp4.de.markers$p_val_adj < 0.1)
Casp4.de.markers.pos$gene <- rownames(Casp4.de.markers.pos)
View(Casp4.de.markers)
View(Casp4.de.markers.pos)
#Make two vectors with the differentially expressed genes and all of the genes expressed
de.genes <- rownames(Casp4.de.markers.pos)
all.genes <- unlist(infected_so@assays$RNA@data@Dimnames[1])
#convert gene names to Entrezid (required for the enrichGO & enrichKEGG functions)
de.genes <- mapIds(org.Mm.eg.db, de.genes, 'ENTREZID', 'SYMBOL')
all.genes <- mapIds(org.Mm.eg.db, all.genes, 'ENTREZID', 'SYMBOL')
#perform the GSEA with GO
enrichment.interstitial <- enrichGO(gene = de.genes, ont = "BP",
OrgDb =org.Mm.eg.db,
universe = all.genes,
readable=TRUE,
pvalueCutoff = 0.05)
tab.go <- as.data.frame(enrichment.interstitial)
tab.go[1:20, 1:6]
#Perform the GSEA with the KEGG database
enrichment.kegg <- enrichKEGG(gene = de.genes,
organism = 'mmu',
universe = all.genes,
pvalueCutoff = 0.05)
tab.kegg <- as.data.frame(enrichment.kegg)
tab.kegg<- subset(tab.kegg, Count>0)
tab.kegg[1:40, 1:6]
group_color = c("midnightblue", "dodgerblue4", "dodgerblue3", "skyblue3","lightskyblue1")
## convert gene ID to Symbol
edox <- setReadable(enrichment.interstitial, 'org.Mm.eg.db', 'ENTREZID')
edox2 <- pairwise_termsim(edox)
treeplot(edox2, nCluster=7, group_color = c("midnightblue", "dodgerblue4", "dodgerblue3", "skyblue4", "dodgerblue2","skyblue3","lightskyblue1")) + scale_color_gradient(low = "sienna4", high="sienna1")
## convert gene ID to Symbol
edox <- setReadable(enrichment.kegg, 'org.Mm.eg.db', 'ENTREZID')
edox2 <- pairwise_termsim(edox)
treeplot(edox2, nCluster=7, group_color = c("midnightblue", "dodgerblue4", "dodgerblue3", "skyblue4", "dodgerblue2","skyblue3","lightskyblue1")) + scale_color_gradient(low = "sienna4", high="sienna1")
